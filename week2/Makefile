hello : hello.c
	gcc hello.c -Wall -Wextra -Werror -o hello

conditions: conditions.c
	gcc conditions.c -Wall -Wextra -Werror -o conditions

input_output: input_output.c 
	gcc input_output.c -Wall -Wextra -Werror -o input_output

loops: loops.c 
	gcc loops.c -Wall -Wextra -Werror -o loops

clean: 
	rm -f hello
	rm -f conditions
	rm -f input_output
	rm -f loops
