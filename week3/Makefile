functions: functions.c
	gcc functions.c  -std=c11 -Wall -Wextra -Werror -o functions
	./functions
	rm -f functions
	
pointers: pointers.c 
	gcc pointers.c -std=c11 -Wall -Wextra -Werror -o pointers
	./pointers
	rm -f pointers
arrays: arrays.c 
	gcc arrays.c -std=c11  -Wall -Wextra -Werror -o arrays
	./arrays
	rm -f arrays

strings: strings.c 
	gcc strings.c -std=c11 -Wall -Wextra -Werror -o strings
	./strings
	rm -f strings

commandLine: commandLine.c 
	gcc commandLine.c -std=c11 -Wall -Wextra -Werror -o commandLine
	./commandLine 2 3 4 5
	rm -f commandLine



clean:
	rm -f functions
	rm -f pointers
	rm -f arrays
