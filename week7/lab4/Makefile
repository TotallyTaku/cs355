mycat: mycat.c
	gcc mycat.c -o mycat
	./mycat file1.txt 
	./mycat file1.txt file2.txt file3.txt
	./mycat -n file1.txt file2.txt
	./mycat -e file1.txt file2.txt
	./mycat -ne file1.txt file2.txt 
	./mycat -es file1.txt file2.txt
	./mycat -ens file1.txt file2.txt file3.txt
	rm -rf mycat


clean:
	rm -rf mycat
